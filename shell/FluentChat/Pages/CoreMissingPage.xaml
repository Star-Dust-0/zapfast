<Page x:Class="FluentChat.Pages.CoreMissingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="420">
        <FontIcon Glyph="&#xE783;" FontSize="40" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
        <TextBlock Text="Core component missing" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
        <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="The Fluent Chat core (core/fluentchatd.exe) is not next to the app. This build packages the shell without the Rust core; a full build bundles both." />
    </StackPanel>
</Page>
