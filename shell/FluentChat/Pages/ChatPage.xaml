<Page x:Class="FluentChat.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fc="using:FluentChat">
    <Page.Resources>
        <fc:FromMeAlignmentConverter x:Key="align" />
        <fc:FromMeBubbleBrush x:Key="bubble" />
        <fc:TimeConverter x:Key="time" />
    </Page.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Padding="12,8" ColumnSpacing="12" BorderThickness="0,0,0,1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <PersonPicture x:Name="HeaderPicture" Width="36" Height="36" DisplayName="{x:Bind Title}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" />
                <TextBlock x:Name="Subtitle" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Search">
                    <FontIcon Glyph="&#xE721;" FontSize="16" />
                </Button>
                <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="More">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>
        <ListView x:Name="MessageList" Grid.Row="1" Padding="16,8" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0,2" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border MaxWidth="520" Padding="10,6" CornerRadius="8"
                        HorizontalAlignment="{Binding FromMe, Converter={StaticResource align}}"
                        Background="{Binding FromMe, Converter={StaticResource bubble}}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="None" />
                            <TextBlock FontSize="10" HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="{Binding Timestamp, Converter={StaticResource time}}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <Grid Grid.Row="2" Padding="12,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Attach">
                <FontIcon Glyph="&#xE723;" FontSize="16" />
            </Button>
            <TextBox x:Name="Composer" Grid.Column="1" PlaceholderText="Type a message"
                KeyDown="OnComposerKeyDown" TextChanged="OnComposerChanged" />
            <Button Width="36" Height="36" Padding="0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Emoji">
                <FontIcon Glyph="&#xE76E;" FontSize="16" />
            </Button>
            <Button x:Name="SendButton" Grid.Column="3" Width="36" Height="36" Padding="0" CornerRadius="18" Background="{ThemeResource AccentFillColorDefaultBrush}"
                Click="OnSend" ToolTipService.ToolTip="Send">
                <FontIcon Glyph="&#xE724;" FontSize="16" Foreground="White" />
            </Button>
        </Grid>
    </Grid>
</Page>
